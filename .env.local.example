# 로컬 개발 설정 예시. 실제 키는 .env.local에만 입력하세요.
# 분석 API 실행에는 유효한 OPENAI_API_KEY가 필요합니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# AI 인용 테스트 (로컬 기본 비활성화)
ENABLE_LLM_CITATION=false
GEMINI_API_KEY=

# 네이버 검색 API: 경쟁사 및 키워드 조회
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 공유 리포트, 벤치마크, 인용 캐시에 공통으로 사용하는 이름
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel KV 대체 이름도 세 기능에서 공통 지원합니다. URL/토큰 쌍으로 설정하세요.
KV_REST_API_URL=
KV_REST_API_TOKEN=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
SCANNER_CONTACT_URL=https://www.mktscanner.com
NEXT_PUBLIC_BRAND_URL=https://prorealmkt.com
NEXT_PUBLIC_CONSULT_URL=https://prorealmkt.com/contact

# 로컬에서만 비워 둡니다. 운영 환경의 접근 제한 설정은 별도 유지하세요.
ALLOWED_IPS=
# INTERNAL_ACCESS_KEY는 현재 운영 방식에서 사용하지 않습니다.
# SLACK_WEBHOOK_URL은 실제 알림을 전송하므로 필요할 때만 별도 설정하세요.
