{
  "name": "marketing-scanner",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:pocket && next build && npm run migrate:report-retention",
    "start": "next start",
    "migrate:report-retention": "node --import tsx scripts/migrate-report-retention.ts",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:retention": "node --import tsx --test tests/report-retention.integration.ts",
    "test:security": "node --import tsx --test tests/security-redis.integration.ts",
    "build:pocket": "npm ci --prefix consumer-app --include=dev --no-audit --no-fund && npm run build --prefix consumer-app && node scripts/stage-pocket-preview.mjs"
  },
  "dependencies": {
    "@upstash/redis": "^1.38.0",
    "cheerio": "^1.0.0",
    "iconv-lite": "^0.6.3",
    "ipaddr.js": "^2.2.0",
    "jspdf": "4.2.1",
    "next": "15.5.26",
    "openai": "^4.67.0",
    "pretendard": "1.3.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^2.12.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "8.5.28",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
